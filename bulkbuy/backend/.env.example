# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication Security Settings
# In production (NODE_ENV=production), JWT_SECRET must be at least 32 cryptographically random characters.
JWT_SECRET=replace-with-a-secure-random-32-char-secret-key-in-prod
JWT_ISSUER=bulkbuy-api
JWT_AUDIENCE=bulkbuy-client
JWT_EXPIRES_IN=24h

# Persistence
DATA_DIR=./data

# Payment Gateway Sandbox Credentials
RAZORPAY_KEY_ID=rzp_test_bulkbuy_sandbox
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder_for_hmac
